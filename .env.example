# Set to "false" to bypass the login guard during local development.
# Any other value (or unset) enforces authentication.
ENABLE_AUTH=false

# JWT secret used to verify the session token in middleware
JWT_SECRET=your_jwt_secret_here

# Cookie names
# JWT_TOKEN_NAME      -> name the backend API expects
# NEXT_JWT_TOKEN_NAME -> name this app stores the token under
JWT_TOKEN_NAME=jwtToken
NEXT_JWT_TOKEN_NAME=front-end-server-jwtToken

# Base URL of the external backend API (not part of this repo yet)
NEXT_PUBLIC_API_URL=http://localhost:8080
